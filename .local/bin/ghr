#!/bin/sh
# ghr — pick a GitHub workflow + branch, trigger a run (herdr: prefix+alt+r).
set -u

cd "${HERDR_ACTIVE_PANE_CWD:-$PWD}" || exit 1

err() { printf '\n  %s\n\n  press enter to close' "$1"; read -r _; exit 1; }

command -v gh  >/dev/null 2>&1 || err "gh CLI not installed"
command -v gum >/dev/null 2>&1 || err "gum not installed: brew install gum"
git rev-parse --git-dir >/dev/null 2>&1 || err "not in a git repository"

git fetch --quiet >/dev/null 2>&1 &

workflows=$(gh workflow list --all 2>&1) || err "failed to list workflows"

name=$(printf '%s\n' "$workflows" | awk -F'\t' '$2 == "active" { print $1 }' \
  | gum filter --height 15 --placeholder 'workflow…') || exit 0
[ -n "$name" ] || exit 0

branch=$(git branch -r | grep -v HEAD | sed -e 's/^ *//' -e 's|^origin/||' \
  | gum filter --height 15 --placeholder "branch for ${name}…") || exit 0
[ -n "$branch" ] || exit 0

if gh workflow run "$name" --ref "$branch"; then
  printf '\n  ✓ triggered "%s" on %s\n' "$name" "$branch"
  sleep 2
else
  err "failed to trigger \"$name\""
fi
