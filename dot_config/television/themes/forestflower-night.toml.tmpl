# Forest Flower NIGHT for television (tv)
#
# Hex variant with true DESIGN.md tokens — fixes the ANSI theme's one
# compromise (gray selection bar). The cursor row is flaneur's recipe:
# surface.raised row + accent.action text ("the current one among many").
#
# ~/.config/television/themes/forestflower.toml is a symlink that the
# appearance watcher (extras/sketchybar/theme.sh) re-points between this
# file and forestflower-day.toml when macOS flips light/dark.

# general
background = "{{ .forestflower.night.surface_deep }}"       # surface0 — panel tint so popups stand off the black floor
border_fg = "{{ .forestflower.night.ansi_bright_black }}"        # visible 1px border tier (same as sketchybar popup borders)
text_fg = "{{ .forestflower.night.ink }}"          # ink.primary
dimmed_text_fg = "{{ .forestflower.night.subtle }}"   # ink.comment — captions / meta
# input
input_text_fg = "{{ .forestflower.night.ink }}"    # typed query = body ink
result_count_fg = "{{ .forestflower.night.muted }}"  # ink.faint
# results
result_name_fg = "{{ .forestflower.night.ink }}"   # rows = ink.primary, no accent hue
result_line_number_fg = "{{ .forestflower.night.muted }}"
result_value_fg = "{{ .forestflower.night.ansi_cyan }}"  # cyan values
selection_bg = "{{ .forestflower.night.surface_raised }}"     # surface.raised — the cursor row (was gray!)
selection_fg = "{{ .forestflower.night.primary }}"     # accent.action — state.active gold
match_fg = "{{ .forestflower.night.primary }}"         # matches = action gold
# preview
preview_title_fg = "{{ .forestflower.night.ansi_blue }}"
# mode pills — accent fill + on-action ink
channel_mode_fg = "{{ .forestflower.night.canvas }}"
channel_mode_bg = "{{ .forestflower.night.primary }}"
remote_control_mode_fg = "{{ .forestflower.night.canvas }}"
remote_control_mode_bg = "{{ .forestflower.night.ansi_blue }}"
action_picker_mode_fg = "{{ .forestflower.night.canvas }}"
action_picker_mode_bg = "{{ .forestflower.night.ansi_cyan }}"
